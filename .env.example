# Copy to .env and fill in what you have. Never commit the .env file.

# --- Required: weather data ---
OPENWEATHER_API_KEY=your_openweathermap_api_key        # https://openweathermap.org/api (free tier is enough)

# --- Optional: real driving routes for the Journey planner (falls back to straight lines) ---
ORS_API_KEY=                                            # https://openrouteservice.org/dev/#/signup

# --- Optional: AI chat + daily briefing. Any ONE of these enables AI. ---
AI_PROVIDER=auto            # auto | groq | openrouter | huggingface | custom
GROQ_API_KEY=               # https://console.groq.com  (recommended: free tier, fast Llama 3.3 70B)
OPENROUTER_API_KEY=         # https://openrouter.ai     (free ":free" models)
HF_API_KEY=                 # https://huggingface.co/settings/tokens (routes via Inference Providers; $0.10/mo free credit)
# For AI_PROVIDER=custom (Ollama, LM Studio, OpenAI, Azure...): OpenAI-compatible base URL
AI_BASE_URL=                # e.g. http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=                   # override the provider default model
AI_TIMEOUT_SECONDS=30

# --- Optional: protect the AI endpoints with a shared secret (send as X-API-Key) ---
SKYPULSE_API_KEY=

# --- Server ---
HOST=127.0.0.1              # use 0.0.0.0 in containers
PORT=9000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9000,http://127.0.0.1:9000
LOG_LEVEL=INFO
LOG_JSON=false              # true → one JSON object per line (for Loki / CloudWatch)
HTTP_TIMEOUT_SECONDS=8
WEATHER_CACHE_TTL=300
FORECAST_CACHE_TTL=900
HOURLY_CACHE_TTL=900
ALERTS_CACHE_TTL=300
